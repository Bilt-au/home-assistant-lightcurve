# Copy to spike/.env and fill in. spike/.env is gitignored.
HA_URL=http://homeassistant.local:8123
# Profile -> Security -> Long-lived access tokens -> Create token
HA_TOKEN=
# The bulbs to probe. First one is the primary and takes the single-light probes.
LIGHTCURVE_SPIKE_ENTITIES=light.lounge_spot_1,light.lounge_spot_2
